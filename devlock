#!/usr/bin/env python3
"""devlock - one agent session per test device at a time.

  devlock run [--timeout SEC] DEVICE[,DEVICE...] -- COMMAND...
                     wait for the devices, run COMMAND holding them, release on exit
                     (a single COMMAND argument runs through bash -c)
  devlock wait [--timeout SEC] DEVICE[,DEVICE...]
                     block until no other session holds the devices
  devlock hold [--ttl 30m] [--note TEXT] DEVICE[,DEVICE...]
                     keep the devices for this session across turns (max 8h; again = extend)
  devlock status [--json | --watch [--interval 2s]]
                     who holds which device, and who is waiting
  devlock whoami     this session's id and what it holds
  devlock check [--bg] [--session ID] [--json] COMMAND...
                     would the hook allow COMMAND now? (exit 0 yes, 1 no; takes no lease)
  devlock log [--denied] [--since 1h] [-n 50] [--session ID] [--json]
                     the hook's recent decisions
  devlock doctor [--fix]
                     check the setup, and find connected names of one device (same ro.serialno)
                     missing from devices.conf; --fix writes them in
  devlock release [DEVICE]
                     drop this session's leases and holds (all devices without DEVICE)
  devlock install [--claude] [--codex] [--cursor] [--conf PATH]
                     register the hooks (default: every agent set up here) and link devices.conf
  devlock hook pre|post|stop|end [--agent claude|codex]
  devlock hook cursor
                     agent hooks (JSON on stdin)

State: $DEVLOCK_DIR (default ~/.local/state/devlock). Device names: devices.conf there.
"""
import concurrent.futures
import contextlib
import fcntl
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import time

STATE = os.environ.get("DEVLOCK_DIR") or os.path.expanduser("~/.local/state/devlock")
CONF = os.environ.get("DEVLOCK_CONF") or os.path.join(STATE, "devices.conf")
LEASE_SEC = int(os.environ.get("DEVLOCK_LEASE_SEC", "300"))
LEASE_MARGIN = 60
STICKY_SEC = int(os.environ.get("DEVLOCK_STICKY_SEC", "120"))
HOLD_MAX_SEC = int(os.environ.get("DEVLOCK_HOLD_MAX", str(8 * 3600)))
BASH_DEFAULT_TIMEOUT_MS = 120000
CURSOR_TIMEOUT_SEC = 600
RUN_DEFAULT_TIMEOUT = 1800
SELF = os.path.abspath(__file__)
ADB = os.environ.get("DEVLOCK_ADB") or "adb"

ADB_FREE = {"devices", "version", "help", "start-server", "connect", "keygen", "mdns", "pair",
            "host-features", "--version", "--help"}
FASTBOOT_FREE = {"devices", "--version", "--help", "help"}
TOOL_OPTS_WITH_ARG = {"-H", "-P", "-L", "-i", "-p", "-c", "-S", "--slot", "--os-version", "--header-version"}
DEVICE_TOOLS = {"adb", "fastboot", "scrcpy"}
KEYWORDS = {"then", "do", "else", "elif", "if", "while", "until", "!", "{", "}", "[[", "time"}
# wrapper -> its options that take a separate argument
WRAPPERS = {
    "sudo": {"-u", "-g", "-C", "-h", "-p", "-r", "-t", "-U", "-D"},
    "env": {"-u", "-C", "-S", "--unset", "--chdir"},
    "nice": {"-n", "--adjustment"},
    "ionice": {"-c", "-n", "-p", "-P", "-u"},
    "stdbuf": {"-i", "-o", "-e"},
    "nohup": set(), "setsid": set(), "command": set(), "builtin": set(),
    "exec": {"-a"},
    "timeout": {"-s", "-k", "--signal", "--kill-after"},
    "watch": {"-n", "--interval", "-d"},
    "xargs": {"-I", "-n", "-P", "-d", "-L", "-s", "-E", "-a", "--max-args", "--max-procs"},
    "chrt": {"-p"}, "taskset": {"-p"}, "unbuffer": set(), "script": {"-c"},
}
INTERPRETERS = {"python", "python3", "node", "uv", "perl", "ruby"}
SHELLS = {"bash", "sh", "zsh"}
SHELL_OPTS_WITH_ARG = {"-o", "+o", "-O", "+O", "--rcfile", "--init-file"}
GRADLE = {"gradlew", "gradle"}
GRADLE_OPTS_WITH_ARG = {"-p", "--project-dir", "-x", "--exclude-task", "-c", "--settings-file", "-b",
                        "--build-file", "-I", "--init-script", "-g", "--gradle-user-home", "--console",
                        "--warning-mode", "--include-build", "--project-cache-dir", "--priority"}
GRADLE_DEVICE_TASK = re.compile(r"^((connected|install|uninstall)[A-Z]\w*(?<!Dist)|deviceCheck)$")
SCRCPY_FREE = {"-v", "--version", "-h", "--help"}
ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")

ALIASES, SCRIPTS = {}, []


SESSION_VARS = (("CLAUDE_CODE_SESSION_ID", "claude"), ("CODEX_SESSION_ID", "codex"))


def session_source():
    """(session id, kind): the agent session this process runs in, or the calling shell."""
    for var, kind in SESSION_VARS:
        if os.environ.get(var):
            return os.environ[var], kind
    return f"shell-{os.getppid()}", "shell"


def session_id():
    return session_source()[0]


def load_conf():
    """Device names and script patterns. A broken line is skipped (and logged), never fatal."""
    if os.path.islink(CONF) and not os.path.exists(CONF):
        log(f"WARN devices.conf is a broken link ({os.readlink(CONF)}): every name is its own device")
    try:
        with open(CONF) as f:
            lines = f.read().splitlines()
    except OSError:
        return
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("script "):
            try:
                SCRIPTS.append(re.compile(line.split(None, 1)[1].strip()))
            except re.error as e:
                log(f"WARN devices.conf: bad script pattern {line!r}: {e}")
            continue
        names = line.split("#", 1)[0].split()
        for n in names:
            ALIASES[n] = names[0]


def canon(name):
    return ALIASES.get(name, name)


def fname(serial):
    return re.sub(r"[^A-Za-z0-9._:-]", "_", serial)


def path(serial, ext):
    return os.path.join(STATE, f"{fname(serial)}.{ext}")


def read_json(p):
    try:
        with open(p) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(p, obj):
    tmp = f"{p}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        if obj is not None:
            json.dump(obj, f)
    os.replace(tmp, p)


def append_rotating(name, text, limit):
    """Append to a file in the state dir, moving it to NAME.1 past limit bytes. A lock on the file
    keeps two hooks from rotating it at once."""
    try:
        os.makedirs(STATE, exist_ok=True)
        p = os.path.join(STATE, name)
        with open(p + ".lock", "a") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX)
            if os.path.exists(p) and os.path.getsize(p) > limit:
                os.replace(p, p + ".1")
            with open(p, "a") as f:
                f.write(text)
    except OSError:
        pass


def log(line):
    append_rotating("hook.log", f"{time.strftime('%F %T')} {line}\n", 1_000_000)


def event(sess, verdict, devices, cmd, reason=None):
    """One hook decision as a JSON line in events.jsonl, for `devlock log`."""
    rec = {"t": round(time.time(), 3), "session": sess, "verdict": verdict, "devices": sorted(devices),
           "cmd": cmd[:2000]}
    if reason:
        rec["reason"] = reason
    append_rotating("events.jsonl", json.dumps(rec) + "\n", 2_000_000)


@contextlib.contextmanager
def mutex(timeout=5.0):
    os.makedirs(STATE, exist_ok=True)
    fd = os.open(os.path.join(STATE, ".mutex"), os.O_RDWR | os.O_CREAT, 0o644)
    deadline = time.time() + timeout
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.time() > deadline:
                    raise TimeoutError("devlock state is locked by a stuck process")
                time.sleep(0.05)
        yield
    finally:
        os.close(fd)


# ---------------------------------------------------------------- holders: runs and leases

def proc_start(pid):
    """When the process started, as an opaque string: with the pid it tells a live process from a
    later one that reused its pid."""
    if os.path.isdir("/proc/self"):
        try:
            with open(f"/proc/{pid}/stat") as f:
                return f.read().rsplit(")", 1)[1].split()[19]
        except (OSError, IndexError, TypeError):
            return None
    try:
        out = subprocess.run(["ps", "-o", "lstart=", "-p", str(int(pid))], capture_output=True, text=True,
                             timeout=5, env=dict(os.environ, LC_ALL="C")).stdout.strip()
        return out or None
    except (OSError, ValueError, TypeError, subprocess.SubprocessError):
        return None


def group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def proc_starts(pids):
    """{pid: start time} for the live ones: one `ps` call where there is no /proc."""
    pids = sorted({int(p) for p in pids if str(p).isdigit()})
    if not pids:
        return {}
    if os.path.isdir("/proc/self"):
        return {p: st for p in pids for st in [proc_start(p)] if st}
    try:
        out = subprocess.run(["ps", "-o", "pid=,lstart=", "-p", ",".join(map(str, pids))], capture_output=True,
                             text=True, timeout=5, env=dict(os.environ, LC_ALL="C")).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    return {int(l.split(None, 1)[0]): l.split(None, 1)[1].strip() for l in out.splitlines() if len(l.split()) > 1}


def alive(entry, starts=None):
    """A run holds its devices while devlock or anything in its command's process group lives,
    so kill -9 frees the device and a grandchild of a killed run still holds it."""
    procs = entry.get("procs", [])
    if starts is None:
        starts = proc_starts(p for p, _ in procs)
    if any(st and starts.get(int(p)) == st for p, st in procs if str(p).isdigit()):
        return True
    return bool(entry.get("pgid")) and group_alive(entry["pgid"])


def live(entries):
    entries = entries or []
    starts = proc_starts(p for e in entries for p, _ in e.get("procs", []))
    return [e for e in entries if alive(e, starts)]


def runs(serial):
    return live(read_json(path(serial, "runs")))


def lease(serial, now=None):
    data = read_json(path(serial, "lease"))
    if data and data.get("until", 0) > (now or time.time()):
        return data
    return None


def hold(serial, now=None):
    data = read_json(path(serial, "hold"))
    if data and data.get("until", 0) > (now or time.time()):
        return data
    return None


def waiters(serial):
    """Live `devlock run` / `wait` processes waiting for this device."""
    return live(read_json(path(serial, "queue")))


def clock(t):
    return time.strftime("%H:%M:%S", time.localtime(t))


def describe(e):
    return f"session={e.get('session')} pid={e.get('pid')} since={e.get('since')} cmd={e.get('cmd')}"


def blockers(serials, sess, now=None, skip_idle=False):
    """Why the devices are not free for sess. skip_idle: a lease kept only for its session's next
    prompt (the sticky window) does not count - queued work takes precedence over it."""
    out = []
    for s in serials:
        for e in runs(s):
            if e.get("session") != sess:
                out.append(f"{s}: another session's run holds it ({describe(e)})")
        h = hold(s, now)
        if h and h.get("session") != sess:
            note = f" ({h['note']})" if h.get("note") else ""
            out.append(f"{s}: held by session {h['session']} until {clock(h['until'])}{note}")
        l = lease(s, now)
        if l and l.get("session") != sess and not (skip_idle and l.get("idle")):
            out.append(f"{s}: in use by session {l['session']} until {clock(l['until'])} at the latest")
    return out


def known_serials():
    if not os.path.isdir(STATE):
        return []
    return sorted({f.rsplit(".", 1)[0] for f in os.listdir(STATE) if f.endswith((".runs", ".lease", ".hold", ".queue"))})


def release(sess, only=None, holds=True, hold_kinds=None):
    now = time.time()
    for s in known_serials():
        if only and s != fname(canon(only)):
            continue
        l = lease(s, now)
        if l and l.get("session") == sess:
            write_json(path(s, "lease"), None)
        h = hold(s, now)
        if holds and h and h.get("session") == sess and (hold_kinds is None or h.get("kind") in hold_kinds):
            write_json(path(s, "hold"), None)


def someone_waits(serial, sess):
    """Another session's run/wait is queued for this device and could take it now: a multi-device
    waiter still blocked on one of its other devices does not count."""
    for w in waiters(serial):
        if w.get("session") == sess:
            continue
        others = [d for d in w.get("devices") or [] if d != serial]
        if not blockers(others, w.get("session"), skip_idle=True):
            return True
    return False


def idle_lease(serial, l, sess, now):
    """The lease after its session's turn: kept STICKY_SEC for the next prompt, or dropped when
    someone is waiting for the device."""
    until = min(l["until"], now + STICKY_SEC)
    if until <= now or someone_waits(serial, sess):
        return None
    return {"session": sess, "until": until, "inflight": {}, "idle": True}


def end_turn(sess):
    now = time.time()
    for s in known_serials():
        l = lease(s, now)
        if not l or l.get("session") != sess:
            continue
        if any(d > now for d in (l.get("inflight") or {}).values()):
            # a command still running (e.g. in a background subagent): its post hook ends the turn
            write_json(path(s, "lease"), dict(l, turn_ended=True))
            continue
        write_json(path(s, "lease"), idle_lease(s, l, sess, now))


# ---------------------------------------------------------------- command analysis

class Chunk:
    def __init__(self, gid, parent):
        self.buf, self.bg, self.gid, self.parent = [], False, gid, parent

    @property
    def text(self):
        return "".join(self.buf).strip()


def split_commands(cmd):
    """Split a shell command into simple commands: on unquoted ; & | && || newline ( ), and into
    $( ) / backtick substitutions, which run even inside double quotes. A substitution's chunks
    carry the gid of the command they sit in as parent. bg marks a command ended by a single &."""
    out, ids = [], iter(range(1 << 30))
    cur = Chunk(next(ids), None)
    stack = []  # '"' or ('(' | '`', enclosing chunk)

    def emit(bg=False):
        nonlocal cur
        if cur.text:
            cur.bg = bg
            out.append(cur)
        elif bg and out:
            out[-1].bg = True
        cur = Chunk(next(ids), cur.parent)

    i, n = 0, len(cmd)
    while i < n:
        c = cmd[i]
        top = stack[-1] if stack and stack[-1] == '"' else (stack[-1][0] if stack else None)
        if c == "\\" and i + 1 < n:
            cur.buf.append(cmd[i:i + 2])
            i += 2
            continue
        if c == "'" and top != '"':
            j = cmd.find("'", i + 1)
            j = n - 1 if j < 0 else j
            cur.buf.append(cmd[i:j + 1])
            i = j + 1
            continue
        if c == "$" and cmd[i + 1:i + 2] == "(" and cmd[i + 2:i + 3] != "(":
            stack.append(("(", cur))
            cur = Chunk(next(ids), cur.gid)
            i += 2
            continue
        if c == "`":
            if top == "`":
                emit()
                cur = stack.pop()[1]
            else:
                stack.append(("`", cur))
                cur = Chunk(next(ids), cur.gid)
            i += 1
            continue
        if top == '"':
            if c == '"':
                stack.pop()
            cur.buf.append(c)
            i += 1
            continue
        if c == '"':
            stack.append('"')
            cur.buf.append(c)
            i += 1
            continue
        if c == ")" and top == "(":
            emit()
            cur = stack.pop()[1]
            i += 1
            continue
        if c == "&":
            prev, nxt = cmd[i - 1:i], cmd[i + 1:i + 2]
            if prev in ("<", ">", "|") or nxt == ">":
                cur.buf.append(c)
                i += 1
            elif nxt == "&":
                emit()
                i += 2
            else:
                emit(bg=True)
                i += 1
            continue
        if c in ";|\n()":
            emit()
            i += 1
            continue
        cur.buf.append(c)
        i += 1
    emit()
    while stack:
        item = stack.pop()
        if item != '"':
            cur = item[1]
            emit()
    return out


def strip_heredocs(cmd):
    """Drop here-document bodies: they are data, not commands."""
    out, lines, i = [], cmd.split("\n"), 0
    while i < len(lines):
        line = lines[i]
        out.append(line)
        i += 1
        for tabs, word in re.findall(r"(?<![<\"'])<<(?!<)(-?)\s*['\"]?([A-Za-z_][A-Za-z0-9_]*)['\"]?", line):
            while i < len(lines) and (lines[i].lstrip("\t") if tabs else lines[i]) != word:
                i += 1
            i += 1
    return "\n".join(out)


def tokens(chunk):
    try:
        return shlex.split(chunk, comments=True)
    except ValueError:
        return chunk.split()


def command_start(toks, i=0):
    """Index of the program word, skipping assignments, keywords and wrappers with their options."""
    while i < len(toks):
        t = toks[i]
        b = os.path.basename(t)
        if ASSIGN.match(t) or t in KEYWORDS:
            i += 1
        elif b in WRAPPERS:
            i += 1
            while i < len(toks) and toks[i].startswith("-") and toks[i] not in ("-", "--"):
                i += 2 if toks[i] in WRAPPERS[b] else 1
            if i < len(toks) and toks[i] == "--":
                i += 1
            if b == "timeout":
                i += 1
            while b == "env" and i < len(toks) and ASSIGN.match(toks[i]):
                i += 1
        else:
            return i
    return None


def mentioned(text):
    found = set()
    for name, serial in ALIASES.items():
        if re.search(r"(?<![A-Za-z0-9._:/-])" + re.escape(name) + r"(?![A-Za-z0-9_:/-]|\.[A-Za-z0-9])", text):
            found.add(serial)
    return found


def literal(v):
    return bool(v) and not re.search(r"[$`*?]", v)


def env_assignments(toks, k):
    """ANDROID_SERIAL set by this simple command: (values for this command only, values for the
    commands after it, whether it unsets it). A prefix assignment or `env` applies to its own
    command; export / declare and a bare assignment last."""
    def vals(ts):
        return [t.split("=", 1)[1] for t in ts if t.startswith("ANDROID_SERIAL=") and t != "ANDROID_SERIAL="]
    if k is None:
        return [], vals(toks), False
    prog = toks[k]
    if prog in ("export", "declare", "local", "typeset", "readonly"):
        return [], vals(toks[:k]) + vals(toks[k + 1:]), False
    return vals(toks[:k]), [], prog == "unset" and "ANDROID_SERIAL" in toks[k + 1:]


class Use:
    def __init__(self):
        self.devices = set()
        self.bg_devices = set()
        self.problems = []
        self.global_op = None
        self.run_devices = set()

    def merge(self, other, bg=False):
        self.devices |= other.devices
        self.bg_devices |= other.bg_devices | (other.devices if bg else set())
        self.problems += other.problems
        self.global_op = self.global_op or other.global_op
        self.run_devices |= other.run_devices


def parse_scrcpy(toks, i, use, env_serials):
    """scrcpy has no subcommand, and many of its options take a value: scan every argument."""
    args, serial, j = toks[i + 1:], None, 0
    if any(a in SCRCPY_FREE for a in args):
        return
    while j < len(args):
        a = args[j]
        if a in ("-s", "--serial") and j + 1 < len(args):
            serial, j = args[j + 1], j + 1
        elif a.startswith("--serial="):
            serial = a.split("=", 1)[1]
        elif a.startswith("--tcpip=") and len(a) > len("--tcpip=+"):
            serial = a.split("=", 1)[1].lstrip("+")
        elif a.startswith("-s") and len(a) > 2 and not a.startswith("--"):
            serial = a[2:]
        elif a in ("-d", "-e", "--select-usb", "--select-tcpip"):
            use.problems.append(f"`scrcpy {a}` picks a device that devlock cannot see. Use `scrcpy -s <serial>`.")
            return
        j += 1
    add_targets("scrcpy", [serial] if serial else sorted(env_serials), use)


def add_targets(tool, targets, use):
    if not targets:
        use.problems.append(f"Name the device: `{tool} -s <serial>` or ANDROID_SERIAL=<serial>. "
                            "Devices are shared between sessions (devlock).")
        return
    for t in targets:
        if not literal(t):
            use.problems.append(f"`{tool} -s {t}`: devlock needs the device spelled out, not a variable.")
        else:
            use.devices.add(canon(t))


def parse_tool(toks, i, tool, use, env_serials):
    if tool == "scrcpy":
        return parse_scrcpy(toks, i, use, env_serials)
    j, serial = i + 1, None
    while j < len(toks):
        a = toks[j]
        if a in ("-s", "--serial") and j + 1 < len(toks):
            serial, j = toks[j + 1], j + 2
        elif a.startswith("--serial="):
            serial, j = a.split("=", 1)[1], j + 1
        elif a.startswith("-s") and len(a) > 2 and tool != "fastboot":
            serial, j = a[2:], j + 1
        elif a in ("-d", "-e", "-t") or a.startswith(("--transport-id", "--select-usb", "--select-tcpip", "-t")):
            use.problems.append(f"`{tool} {a}` picks a device that devlock cannot see. Use `{tool} -s <serial>`.")
            return
        elif a in TOOL_OPTS_WITH_ARG:
            j += 2
        elif a.startswith("-") and a not in ("--version", "--help"):
            j += 1
        else:
            break
    sub = toks[j] if j < len(toks) else None
    args = toks[j + 1:]
    if sub is None or sub in (ADB_FREE if tool == "adb" else FASTBOOT_FREE):
        return
    if tool == "adb" and sub == "kill-server":
        use.global_op = "adb kill-server"
        return
    if tool == "adb" and sub == "disconnect":
        if not args:
            use.global_op = "adb disconnect (all devices)"
        else:
            use.devices |= {canon(a) for a in args if literal(a)}
        return
    if tool == "adb" and sub == "reconnect" and serial is None and not env_serials:
        use.global_op = "adb reconnect (all devices)"
        return
    add_targets(tool, [serial] if serial else sorted(env_serials), use)


def shell_command_arg(args):
    """The command string of `bash -c CMD` / `bash -lc CMD` / `sh -ec CMD`, or None."""
    has_c, j = False, 0
    while j < len(args):
        a = args[j]
        if a == "--":
            j += 1
            break
        if a in SHELL_OPTS_WITH_ARG:
            j += 2
            continue
        if re.match(r"^[-+][A-Za-z]+$", a):
            has_c = has_c or (a[0] == "-" and "c" in a)
        elif not a.startswith("--"):
            break
        j += 1
    return args[j] if has_c and j < len(args) else None


def gradle_device_tasks(args):
    out, j = [], 0
    while j < len(args):
        a = args[j]
        if a in GRADLE_OPTS_WITH_ARG:
            j += 2
            continue
        if not a.startswith("-") and GRADLE_DEVICE_TASK.search(a.rsplit(":", 1)[-1]):
            out.append(a)
        j += 1
    return out


def visit(toks, k, chunk, use, env_serials, depth):
    """Analyze the simple command whose program word is toks[k]."""
    prog = os.path.basename(toks[k])
    rest = toks[k + 1:]
    if prog in DEVICE_TOOLS:
        parse_tool(toks, k, prog, use, env_serials)
    elif prog in SHELLS and shell_command_arg(rest) is not None:
        if depth < 4:
            use.merge(analyze(shell_command_arg(rest), depth + 1, env_serials))
    elif prog in GRADLE and gradle_device_tasks(rest):
        if env_serials:
            add_targets(prog, [x for s in sorted(env_serials) for x in s.split(",") if x], use)
        else:
            use.problems.append(f"`{prog} {gradle_device_tasks(rest)[0]}` runs on every connected device: "
                                f"name one with `ANDROID_SERIAL=<serial> {toks[k]} ...`.")
    elif prog == "find":
        for x, t in enumerate(toks):
            if t in ("-exec", "-execdir", "-ok", "-okdir"):
                end = next((y for y in range(x + 1, len(toks)) if toks[y] in (";", "+")), len(toks))
                sub = toks[x + 1:end]
                kk = command_start(sub)
                if kk is not None:
                    visit(sub, kk, " ".join(sub), use, env_serials, depth)
    elif (prog.endswith((".sh", ".py")) or "/" in toks[k] or prog in INTERPRETERS
          or (prog in SHELLS and rest) or prog in ("gradlew", "make", "pytest")):
        named = mentioned(chunk) | {canon(s) for s in env_serials}
        use.devices |= named
        if not named and any(p.search(chunk) for p in SCRIPTS):
            use.problems.append("This script picks a test device on its own: pass the device explicitly "
                                "(--device <serial or address>) so devlock can lock it.")


def analyze(cmd, depth=0, inherited_env=()):
    use = Use()
    chunks = [(c, tokens(c.text)) for c in split_commands(strip_heredocs(cmd))]
    session_env = set(inherited_env)
    chunk_env = {}
    for c, toks in chunks:
        own, lasting, unset = env_assignments(toks, command_start(toks))
        for v in own + lasting:
            if not literal(v):
                use.problems.append("ANDROID_SERIAL must be a literal serial for devlock, not a variable.")
            else:
                use.devices.add(canon(v))
        own, lasting = [v for v in own if literal(v)], [v for v in lasting if literal(v)]
        chunk_env[c.gid] = {own[-1]} if own else set(session_env)
        if lasting:
            session_env = {lasting[-1]}
        elif unset:
            session_env = set()

    parent = {c.gid: c.parent for c, _ in chunks}
    run_gids = set()
    for c, toks in chunks:
        k = command_start(toks)
        if k is not None and os.path.basename(toks[k]) == "devlock" and toks[k + 1:k + 2] == ["run"]:
            run_gids.add(c.gid)

    def inside_run(gid):
        seen = set()
        while gid is not None and gid not in seen:
            seen.add(gid)
            gid = parent.get(gid)
            if gid in run_gids:
                return True
        return False

    for c, toks in chunks:
        k = command_start(toks)
        if k is None or inside_run(c.gid):
            continue
        rest = toks[k + 1:]
        if os.path.basename(toks[k]) == "devlock":
            if rest[:1] == ["run"]:
                check_run(rest, use, depth)
            continue
        part = Use()
        visit(toks, k, c.text, part, chunk_env[c.gid], depth)
        use.merge(part, bg=c.bg)
    return use


def check_run(rest, use, depth):
    if "--" not in rest:
        return
    held = set()
    args = rest[1:rest.index("--")]
    skip = False
    for a in args:
        if skip:
            skip = False
        elif a == "--timeout":
            skip = True
        else:
            held |= {canon(x) for x in a.split(",") if x}
    use.run_devices |= held
    inner = rest[rest.index("--") + 1:]
    inner_cmd = inner[0] if len(inner) == 1 else shlex.join(inner)
    iu = analyze(inner_cmd, depth + 1) if depth < 4 else Use()
    extra = iu.devices - held
    if extra:
        use.problems.append(f"The run also uses {', '.join(sorted(extra))}: list every device "
                            "it touches, e.g. devlock run A,B -- ...")
    if len(held) > 1 and iu.problems:
        use.problems.append("A run over several devices sets no ANDROID_SERIAL: name the device "
                            "in every adb/fastboot call inside it.")
    if iu.global_op:
        use.problems.append(f"`{iu.global_op}` affects every device; do not run it inside a run.")


# ---------------------------------------------------------------- hooks

def misuse(use, background, agent="claude"):
    """Why the pre hook refuses this command whatever the devices' state, or None."""
    if use.problems:
        return use.problems[0]
    bg = use.devices if background else use.bg_devices
    if bg:
        how = ("with the Bash tool's run_in_background, not a trailing &" if agent == "claude"
               else "not with a trailing &")
        return ("Background work on a shared device must hold it for its whole life: run it as "
                f"`{SELF} run {','.join(sorted(bg))} -- <command>` ({how}).")
    return None


def verdict(use, sess, background, now, agent="claude"):
    """Why the pre hook refuses this command for sess, or None. Reads state, writes nothing."""
    reason = misuse(use, background, agent)
    if reason:
        return reason
    if use.global_op:
        busy = blockers(known_serials(), sess, now)
        if busy:
            return (f"`{use.global_op}` would cut off other sessions' devices ({'; '.join(busy)}). "
                    "Do not run it while they are in use.")
    busy = blockers(sorted(use.devices), sess, now)
    if busy:
        return (f"Device busy - {'; '.join(busy)}. Do not work around this (other spellings, deleting lock "
                f"files). Queue with `{SELF} run <device> -- <command>` in the background, or use another device.")
    return None


AGENTS = ("claude", "codex", "cursor")
CURSOR_EVENTS = {"beforeShellExecution": "pre", "afterShellExecution": "post", "stop": "stop", "sessionEnd": "end"}


def respond(agent, reason=None):
    """The pre hook's answer in the agent's format. Cursor needs an answer either way (it blocks on
    none); its own "ask" still wins over our allow."""
    if agent == "cursor":
        print(json.dumps({"permission": "deny", "user_message": f"devlock: {reason}", "agent_message": reason}
                         if reason else {"permission": "allow"}))
    elif reason:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": reason}}))


def refuse(sess, cmd, reason, devices=()):
    log(f"DENY {sess} {cmd!r}: {reason}")
    event(sess, "deny", devices, cmd, reason)
    return reason


def tool_timeout(agent, ti):
    """How long the agent lets this command run, in seconds."""
    if agent == "cursor":
        return CURSOR_TIMEOUT_SEC
    try:
        if ti.get("timeout_ms"):
            return float(ti["timeout_ms"]) / 1000
        return float(ti.get("timeout") or BASH_DEFAULT_TIMEOUT_MS) / 1000
    except (TypeError, ValueError):
        return BASH_DEFAULT_TIMEOUT_MS / 1000


class HookCall:
    """One hook invocation, whatever the agent: mode is pre, post, stop or end."""
    def __init__(self, mode, sess, tool, ti, call):
        self.mode, self.sess, self.tool, self.ti, self.call = mode, sess, tool, ti, call


def hook_input(mode, agent, data):
    """The agent's hook payload as a HookCall, or None to ignore it."""
    if not isinstance(data, dict):
        return None
    if agent == "cursor":
        mode = CURSOR_EVENTS.get(data.get("hook_event_name"), mode)
        sess = data.get("conversation_id") or data.get("session_id")
        ti = {"command": data.get("command")}
        tool = "Shell"
        # Cursor has no call id: before and after a command both carry the command itself
        call = str(data.get("command") or "")
    else:
        if data.get("hook_event_name") == "SessionEnd":
            mode = "end"
        sess = data.get("session_id")
        ti = data.get("tool_input") or {}
        tool = data.get("tool_name", "Bash")
        call = str(data.get("tool_use_id") or "")
        if isinstance(ti, dict) and isinstance(ti.get("command"), list):
            ti = dict(ti, command=shlex.join(str(x) for x in ti["command"]))
    if not sess or not isinstance(ti, dict):
        return None
    return HookCall(mode, str(sess), tool, ti, call)


def hook(h, agent="claude"):
    """Apply one hook call to the state. For a pre call, returns the refusal reason or None."""
    sess, ti, call = h.sess, h.ti, h.call
    if h.mode == "stop":
        with mutex():
            end_turn(sess)
        return None
    if h.mode == "end":
        with mutex():
            release(sess, hold_kinds=set(AGENTS))
        return None
    cmd = ti.get("command")
    if not isinstance(cmd, str) or not cmd:
        return None
    use = analyze(cmd)
    if not use.devices and not use.global_op and not use.problems and not use.run_devices:
        return None
    now = time.time()
    if h.mode == "post":
        with mutex():
            for s in use.devices:
                l = lease(s, now)
                if l and l.get("session") != sess:
                    continue
                l = l or {"session": sess, "until": 0}
                inflight = {k: v for k, v in (l.get("inflight") or {}).items() if k != call and v > now}
                if l.get("turn_ended"):
                    write_json(path(s, "lease"), dict(l, inflight=inflight) if inflight
                               else idle_lease(s, l, sess, now))
                    continue
                write_json(path(s, "lease"), {"session": sess, "until": max(l["until"], now + LEASE_SEC),
                                              "inflight": inflight})
        return None
    if h.mode != "pre":
        return None

    background = h.tool == "Monitor" or bool(ti.get("run_in_background"))
    reason = misuse(use, background, agent)
    if reason:
        return refuse(sess, cmd, reason, use.devices)
    try:
        with mutex():
            reason = verdict(use, sess, background, now, agent)
            if reason:
                return refuse(sess, cmd, reason, use.devices)
            deadline = now + max(LEASE_SEC, tool_timeout(agent, ti) + LEASE_MARGIN)
            for s in use.devices:
                l = lease(s, now) or {"until": 0}
                inflight = {k: v for k, v in (l.get("inflight") or {}).items() if v > now}
                if call:
                    inflight[call] = deadline
                write_json(path(s, "lease"), {"session": sess, "until": max(l["until"], deadline),
                                              "inflight": inflight})
            if agent == "cursor":
                # A run started from Cursor is a session of its own (Cursor gives its commands no
                # session id): the conversation's lease must not keep its own run waiting.
                for s in use.run_devices - use.devices:
                    l = lease(s, now)
                    if l and l.get("session") == sess:
                        write_json(path(s, "lease"), None)
            if use.devices:
                log(f"ALLOW {sess} {sorted(use.devices)} {cmd!r}")
                event(sess, "allow", use.devices, cmd)
    except TimeoutError as e:
        return refuse(sess, cmd, f"devlock: {e}; retry in a moment.", use.devices)
    return None


# ---------------------------------------------------------------- CLI

def parse_device_args(cmd, argv, opts):
    """`[--opt VALUE]... DEVICE[,DEVICE]... [-- COMMAND...]` -> (option values, device names, command).
    opts maps each option to its default."""
    vals, names, i = dict(opts), [], 0
    while i < len(argv) and argv[i] != "--":
        a = argv[i]
        if a in opts:
            if i + 1 >= len(argv) or argv[i + 1] == "--":
                sys.exit(f"devlock {cmd}: {a} needs a value")
            vals[a], i = argv[i + 1], i + 2
            continue
        if a.startswith("--"):
            sys.exit(f"devlock {cmd}: unknown option {a}")
        names += [x for x in a.split(",") if x]
        i += 1
    if not names:
        sys.exit(f"devlock {cmd}: name at least one device")
    return vals, names, argv[i + 1:]


def acquire(serials, sess, timeout, entry=None, cancelled=lambda: False):
    """Wait until no other session holds the devices; with entry, register it as a run on them.
    While waiting, a ticket in <device>.queue tells holders that someone is waiting. A run (entry)
    takes over other sessions' idle leases; a plain wait does not, since it takes nothing.
    Returns False when cancelled() turned true while waiting."""
    deadline = time.time() + timeout if timeout else None
    me = os.getpid()
    ticket = None
    try:
        while True:
            if cancelled():
                return False
            with mutex(30):
                busy = blockers(serials, sess, skip_idle=bool(entry))
                if not busy:
                    if entry:
                        for s in serials:
                            l = lease(s)
                            if l and l.get("session") != sess:
                                write_json(path(s, "lease"), None)
                            write_json(path(s, "runs"), runs(s) + [entry])
                    return True
                if ticket is None:
                    ticket = {"session": sess, "pid": me, "since": time.strftime("%T"), "devices": serials,
                              "cmd": (entry or {}).get("cmd", "devlock wait"), "procs": [[me, proc_start(me)]]}
                    for s in serials:
                        write_json(path(s, "queue"), waiters(s) + [ticket])
                    print(f"[devlock] busy: {'; '.join(busy)}; queued", file=sys.stderr, flush=True)
            if deadline and time.time() > deadline:
                print(f"[devlock] gave up after {timeout:.0f}s waiting for {', '.join(serials)}", file=sys.stderr)
                sys.exit(75)
            time.sleep(1)
    finally:
        if ticket is not None:
            update_entries(serials, me, "queue")


def update_entries(serials, pid, ext, entry=None):
    live = runs if ext == "runs" else waiters
    with mutex(30):
        for s in serials:
            others = [e for e in live(s) if e.get("pid") != pid]
            write_json(path(s, ext), others + ([entry] if entry else []))


def update_run(serials, pid, entry=None):
    update_entries(serials, pid, "runs", entry)


def adb_name(name):
    """The name adb knows the device by right now (a nickname is not one)."""
    serial = canon(name)
    names = [name, serial] + sorted((a for a, s in ALIASES.items() if s == serial and ":" in a), key=len, reverse=True)
    connected = {n for n, _ in adb_devices() or []}
    return next((n for n in names if n in connected), name if name == serial or ":" in name else serial)


def cmd_run(argv):
    opts, names, command = parse_device_args("run", argv, {"--timeout": RUN_DEFAULT_TIMEOUT})
    timeout = parse_duration("run", "--timeout", str(opts["--timeout"]))
    if not command:
        sys.exit("devlock run: missing -- COMMAND")
    serials = sorted({canon(n) for n in names})
    me = os.getpid()
    entry = {"session": session_id(), "pid": me, "since": time.strftime("%T"),
             "cmd": " ".join(command)[:200], "procs": [[me, proc_start(me)]]}
    child, pending = None, []

    def forward(sig, _):
        if child is None:
            pending.append(sig)
        else:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(child.pid, sig)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, forward)
    acquire(serials, entry["session"], timeout, entry, cancelled=lambda: bool(pending))
    try:
        if pending:
            return 128 + pending[0]
        print(f"[devlock] holding {', '.join(serials)}", file=sys.stderr, flush=True)
        env = dict(os.environ, DEVLOCK_HELD=",".join(serials))
        if len(serials) == 1:
            env["ANDROID_SERIAL"] = adb_name(names[0])
        argv = ["bash", "-c", command[0]] if len(command) == 1 else command
        try:
            child = subprocess.Popen(argv, env=env, start_new_session=True)
        except OSError as e:
            print(f"[devlock] {e}", file=sys.stderr)
            return 127
        entry["pgid"] = child.pid
        update_run(serials, me, entry)
        if pending:
            forward(pending[0], None)
        rc = child.wait()
        return 128 - rc if rc < 0 else rc
    finally:
        # The command's process group may outlive bash -c; keep holding until it is gone.
        if child is not None:
            while group_alive(child.pid):
                time.sleep(0.5)
        update_run(serials, me)


def cmd_wait(argv):
    opts, names, _ = parse_device_args("wait", argv, {"--timeout": 0})
    timeout = parse_duration("wait", "--timeout", str(opts["--timeout"]))
    pending = []
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda n, _: pending.append(n))
    if not acquire(sorted({canon(n) for n in names}), session_id(), timeout, cancelled=lambda: bool(pending)):
        return 128 + pending[0]
    return 0


def cmd_hold(argv):
    opts, names, _ = parse_device_args("hold", argv, {"--ttl": "30m", "--note": ""})
    ttl, note = parse_duration("hold", "--ttl", opts["--ttl"]), opts["--note"]
    if not 0 < ttl <= HOLD_MAX_SEC:
        sys.exit(f"devlock hold: --ttl must be between 1s and {HOLD_MAX_SEC // 3600}h")
    sess = session_id()
    serials = sorted({canon(n) for n in names})
    until = time.time() + ttl
    with mutex(30):
        busy = blockers(serials, sess) + [
            f"{s}: {len(q)} job(s) of other sessions waiting for it"
            for s in serials for q in [[w for w in waiters(s) if w.get("session") != sess]] if q]
        if busy:
            print(f"devlock hold: busy - {'; '.join(busy)}. Wait for it with `devlock wait "
                  f"{','.join(serials)}`, then hold.", file=sys.stderr)
            return 1
        kind = session_source()[1]
        for s in serials:
            write_json(path(s, "hold"), {"session": sess, "kind": kind, "until": until, "note": note,
                                         "since": time.strftime("%T")})
    print(f"[devlock] holding {', '.join(serials)} until {clock(until)}"
          f"{' (ends with this agent session)' if kind != 'shell' else ''}; release with `devlock release`")
    return 0


def parse_flags(cmd, argv, spec):
    """Options from spec ({option: default}; a bool default makes it a flag) -> (values, positional).
    Options end at the first positional argument or `--`."""
    vals, pos, i = dict(spec), [], 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            pos += argv[i + 1:]
            break
        if pos:
            pos.append(a)
            i += 1
            continue
        if a in spec:
            if isinstance(spec[a], bool):
                vals[a], i = True, i + 1
                continue
            if i + 1 >= len(argv):
                sys.exit(f"devlock {cmd}: {a} needs a value")
            vals[a], i = argv[i + 1], i + 2
            continue
        if a.startswith("-") and a != "-":
            sys.exit(f"devlock {cmd}: unknown option {a}")
        pos.append(a)
        i += 1
    return vals, pos


def parse_duration(cmd, opt, v):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([smhd]?)", v or "")
    if not m:
        sys.exit(f"devlock {cmd}: bad {opt} {v!r} (e.g. 90s, 30m, 2h, 1d)")
    return float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]


def entries():
    """(device, kind, entry) for every holder and waiter: kind is run, hold, lease or waiting."""
    for s in known_serials():
        for e in runs(s):
            yield s, "run", e
        h = hold(s)
        if h:
            yield s, "hold", h
        l = lease(s)
        if l:
            yield s, "lease", l
        for e in waiters(s):
            yield s, "waiting", e


def entry_line(s, kind, e, n=0):
    if kind == "run":
        return f"{s}  run: {describe(e)}"
    if kind == "hold":
        note = f" note={e['note']!r}" if e.get("note") else ""
        return f"{s}  hold: session={e['session']} until {clock(e['until'])}{note}"
    if kind == "lease":
        idle = " (idle after its turn)" if e.get("idle") else ""
        return f"{s}  lease: session={e['session']} until {clock(e['until'])}{idle}"
    return f"{s}  waiting #{n}: {describe(e)}"


def public(s, kind, e, n=0):
    out = {"device": s, "kind": kind}
    out.update({k: v for k, v in e.items() if k not in ("procs", "inflight", "turn_ended")})
    if kind == "waiting":
        out["position"] = n
    return out


def numbered(items):
    """entries() with each waiter's queue position."""
    pos = {}
    for s, kind, e in items:
        n = 0
        if kind == "waiting":
            n = pos[s] = pos.get(s, 0) + 1
        yield s, kind, e, n


def print_status(sess):
    shown = False
    for s, kind, e, n in numbered(entries()):
        print(entry_line(s, kind, e, n) + ("  (this session)" if e.get("session") == sess else ""))
        shown = True
    if not shown:
        print("all devices free")
    print(f"(this session: {sess})")


def cmd_status(argv):
    opts, pos = parse_flags("status", argv, {"--json": False, "--watch": False, "--interval": "2"})
    if pos:
        sys.exit(f"devlock status: unexpected argument {pos[0]}")
    sess = session_id()
    if opts["--json"]:
        if opts["--watch"]:
            sys.exit("devlock status: --json and --watch do not mix")
        print(json.dumps({"session": sess, "entries": [public(*x) for x in numbered(entries())]}, indent=2))
        return 0
    if not opts["--watch"]:
        print_status(sess)
        return 0
    interval = max(0.2, parse_duration("status", "--interval", opts["--interval"]))
    tty = sys.stdout.isatty()
    try:
        while True:
            if tty:
                sys.stdout.write("\033[H\033[2J")
            print(f"devlock status  {time.strftime('%T')}  (every {interval:g}s, Ctrl-C to stop)\n")
            print_status(sess)
            sys.stdout.flush()
            time.sleep(interval)
    except KeyboardInterrupt:
        return 0


def cmd_whoami():
    sess = session_id()
    kind = session_source()[1]
    names = {"claude": "Claude Code session", "codex": "Codex session"}
    if kind in names:
        print(f"session: {sess} ({names[kind]})")
    else:
        print(f"session: {sess} (no agent session: tied to the parent process {os.getppid()})")
    mine = [x for x in numbered(entries()) if x[2].get("session") == sess]
    if not mine:
        print("holding nothing")
    for s, kind, e, n in mine:
        print(entry_line(s, kind, e, n))
    return 0


def cmd_check(argv):
    spec = {"--bg": False, "--session": "", "--json": False}
    opts, pos = parse_flags("check", argv, spec)
    while pos:
        if pos[-1] in spec and spec[pos[-1]] is False:
            opts[pos.pop()] = True
        elif len(pos) > 1 and pos[-2] == "--session":
            opts["--session"] = pos.pop()
            pos.pop()
        else:
            break
    if not pos:
        sys.exit("devlock check: give the command, e.g. devlock check 'adb -s tv1 reboot'")
    cmd = pos[0] if len(pos) == 1 else shlex.join(pos)
    sess = opts["--session"] or session_id()
    use = analyze(cmd)
    reason = verdict(use, sess, opts["--bg"], time.time())
    devices = sorted(use.devices)
    device_cmd = bool(use.devices or use.global_op or use.problems)
    res = "deny" if reason else ("allow" if device_cmd else "ignore")
    if opts["--json"]:
        print(json.dumps({"verdict": res, "devices": devices, "global_op": use.global_op, "reason": reason,
                          "session": sess}))
    elif res == "ignore":
        print("not a device command: the hook lets it through")
    else:
        if devices:
            print(f"devices: {', '.join(devices)}")
        if use.global_op:
            print(f"affects every device: {use.global_op}")
        print(f"deny: {reason}" if reason else
              f"allow{' (takes a lease on ' + ', '.join(devices) + ')' if devices else ''}")
    return 1 if reason else 0


def read_events():
    out = []
    for p in ("events.jsonl.1", "events.jsonl"):
        try:
            with open(os.path.join(STATE, p)) as f:
                for line in f:
                    with contextlib.suppress(ValueError):
                        rec = json.loads(line)
                        if isinstance(rec, dict):
                            out.append(rec)
        except OSError:
            pass
    return out


def cmd_log(argv):
    opts, pos = parse_flags("log", argv, {"--denied": False, "--since": "", "-n": "50", "--session": "",
                                         "--json": False})
    if pos:
        sys.exit(f"devlock log: unexpected argument {pos[0]}")
    try:
        limit = int(opts["-n"])
    except ValueError:
        sys.exit(f"devlock log: bad -n {opts['-n']!r}")
    since = time.time() - parse_duration("log", "--since", opts["--since"]) if opts["--since"] else 0
    recs = [r for r in read_events()
            if r.get("t", 0) >= since
            and (not opts["--denied"] or r.get("verdict") == "deny")
            and (not opts["--session"] or r.get("session") == opts["--session"])]
    recs = recs[-limit:] if limit > 0 else recs
    for r in recs:
        if opts["--json"]:
            print(json.dumps(r))
            continue
        first = (r.get("cmd") or "").strip().splitlines() or [""]
        cmd = first[0][:120] + (" ..." if len(first) > 1 or len(first[0]) > 120 else "")
        print(f"{time.strftime('%m-%d %T', time.localtime(r.get('t', 0)))}  {r.get('verdict', '?').upper():5}  "
              f"{str(r.get('session'))[:8]}  {','.join(r.get('devices') or []) or '-':20}  {cmd}")
        if r.get("reason"):
            print(f"{'':16}{r['reason']}")
    if not recs and not opts["--json"]:
        print("no matching events")
    return 0


# ---------------------------------------------------------------- doctor

GENERIC_SERIALS = {"", "unknown", "0123456789ABCDEF", "0123456789abcdef", "1234567890"}


def adb(*args, timeout=10):
    try:
        r = subprocess.run([ADB, *args], capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def adb_devices():
    """[(name, state)] that adb sees right now, or None when adb does not run."""
    out = adb("devices")
    if out is None:
        return None
    return [tuple(l.split()[:2]) for l in out.splitlines()[1:] if len(l.split()) >= 2]


def conf_lines():
    try:
        with open(CONF) as f:
            return f.read().splitlines()
    except OSError:
        return []


def device_names(line):
    """The names on a devices.conf device line, or None for blanks, comments and script lines."""
    body = (line or "").split("#", 1)[0].strip()
    if not body or body.startswith("script "):
        return None
    return body.split()


ADDR = re.compile(r"(\d+\.\d+\.\d+\.\d+):\d+")


def is_address(name):
    return bool(ADDR.fullmatch(name) or re.fullmatch(r"\d+\.\d+\.\d+\.\d+", name)
                or "._adb" in name or name.startswith("adb-"))


def wanted_names(serial, names, shared_hosts=()):
    """Every name one device should be listed under: its serial, the adb names it was seen under,
    and the bare host of a host:port address unless another device uses the same host."""
    out = [serial]
    for n in sorted(names, key=lambda n: (":" not in n, n)):
        out.append(n)
        m = ADDR.fullmatch(n)
        if m and m.group(1) not in shared_hosts:
            out.append(m.group(1))
    return list(dict.fromkeys(out))


def plan_aliases(groups, lines):
    """groups: serial -> the adb names it answers to now. Returns (problems, new devices.conf lines).

    What adb shows now wins: a device's names go on the line that starts with its serial (or with
    one of its own names), lines split over several such lines are merged, and a name that now
    reaches a device listed on another device's line (an address taken over after DHCP) is moved."""
    lines, problems = list(lines), []
    hosts = {}
    for serial, names in groups.items():
        for n in names:
            m = ADDR.fullmatch(n)
            if m:
                hosts.setdefault(m.group(1), set()).add(serial)
    shared = {h for h, sers in hosts.items() if len(sers) > 1}
    owner = {}
    for serial, names in groups.items():
        for n in wanted_names(serial, names, shared):
            owner[n] = serial
    for serial, names in sorted(groups.items()):
        want = wanted_names(serial, names, shared)
        own, foreign = [], []
        for i, l in enumerate(lines):
            ns = device_names(l)
            if not ns or not set(ns) & set(want):
                continue
            first = ns[0]
            if first in want or (is_address(first) and first not in owner):
                own.append(i)
            else:
                foreign.append(i)
        for i in foreign:
            ns = device_names(lines[i])
            moved = [n for n in ns if n in want]
            problems.append(f"{serial}: {', '.join(moved)} now reach{'es' if len(moved) == 1 else ''} this device "
                            f"but {'is' if len(moved) == 1 else 'are'} listed on {ns[0]}'s line")
            lines[i] = replace_names(lines[i], [n for n in ns if n not in want])
        if not own:
            if not foreign:
                problems.append(f"{serial}: not in devices.conf (seen as {', '.join(sorted(names))})")
            lines.append(" ".join(want))
            continue
        keep = next((i for i in own if device_names(lines[i])[0] == serial), own[0])
        merged = list(device_names(lines[keep]))
        for i in own:
            merged += [n for n in device_names(lines[i]) if n not in merged]
        missing = [n for n in want if n not in merged]
        if len(own) > 1:
            problems.append(f"{serial}: split over {len(own)} devices.conf lines, so one device has "
                            f"{len(own)} locks: {' | '.join(' '.join(device_names(lines[i])) for i in own)}")
        if missing:
            problems.append(f"{serial}: not listed under {', '.join(missing)}")
        if len(own) == 1 and not missing:
            continue
        lines[keep] = replace_names(lines[keep], merged + missing)
        for i in sorted(own, reverse=True):
            if i != keep:
                del lines[i]
    return problems, [l for l in lines if l is not None]


def replace_names(line, names):
    """The device line with these names, keeping its comment. None when no name is left."""
    comment = line.split("#", 1)[1] if "#" in line else None
    if not names:
        return f"#{comment}" if comment is not None else None
    return " ".join(names) + (f"  #{comment}" if comment is not None else "")


def claude_dir():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def hook_events_registered():
    """Claude Code hook events that run devlock, from settings.json and settings.local.json, or None
    when neither exists."""
    found, seen = set(), False
    for name in ("settings.json", "settings.local.json"):
        data = read_json(os.path.join(claude_dir(), name))
        if not isinstance(data, dict):
            continue
        seen = True
        for ev, groups in (data.get("hooks") or {}).items():
            if any(is_devlock_hook(h) for h in hook_entries(groups)):
                found.add(ev)
    return found if seen else None


def write_conf(lines):
    """Write devices.conf in place (through a symlink), keeping a backup in the state dir."""
    target = os.path.realpath(CONF)
    if os.path.exists(target):
        backup = os.path.join(STATE, f"devices.conf.bak-{time.strftime('%Y%m%d-%H%M%S')}")
        with open(target) as src, open(backup, "w") as dst:
            dst.write(src.read())
    tmp = f"{target}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    if os.path.exists(target):
        os.chmod(tmp, os.stat(target).st_mode & 0o7777)
    os.replace(tmp, target)
    return target


# ---------------------------------------------------------------- install

def codex_dir():
    return os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")


def cursor_dir():
    return os.path.expanduser("~/.cursor")


def is_devlock_hook(h):
    c = str((h or {}).get("command", ""))
    return "devlock" in c and " hook" in c


def hook_entries(groups):
    """The hook commands in one event's list: nested ({"hooks": [...]}) or flat (Cursor)."""
    for g in groups or []:
        if isinstance(g, dict):
            yield from (g.get("hooks") or []) if "hooks" in g else [g]


def strip_devlock(groups, nested=True):
    """Hook groups without devlock's own entries (from an earlier install)."""
    out = []
    for g in groups or []:
        if not nested:
            if not is_devlock_hook(g):
                out.append(g)
            continue
        hooks = [h for h in (g or {}).get("hooks") or [] if not is_devlock_hook(h)]
        if hooks:
            out.append(dict(g, hooks=hooks))
    return out


def update_json(p, change):
    """Apply change() to the JSON object in file p (written in place, so a symlinked file stays a
    link), with a backup when it changes. Returns 'updated' or 'unchanged'."""
    old = read_json(p) if os.path.exists(p) else {}
    if not isinstance(old, dict):
        sys.exit(f"devlock install: {p} is not a JSON object; fix or move it first")
    new = change(json.loads(json.dumps(old)))
    if new == old and os.path.exists(p):
        return "unchanged"
    os.makedirs(os.path.dirname(p), exist_ok=True)
    if os.path.exists(p):
        with open(p) as src, open(f"{p}.bak-devlock-{time.strftime('%Y%m%d-%H%M%S')}", "w") as dst:
            dst.write(src.read())
    with open(p, "w") as f:
        json.dump(new, f, indent=2)
        f.write("\n")
    return "updated"


def hook_spec(agent):
    """(event, matcher, devlock hook arguments, timeout) to register for each agent."""
    if agent == "claude":
        return [("PreToolUse", "Bash|Monitor", "pre", 10), ("PostToolUse", "Bash", "post", 10),
                ("PostToolUseFailure", "Bash", "post", 10), ("Stop", None, "stop", 10),
                ("SessionEnd", None, "end", 10)]
    if agent == "codex":
        return [("PreToolUse", "Bash", "pre --agent codex", 10), ("PostToolUse", "Bash", "post --agent codex", 10),
                ("Stop", None, "stop --agent codex", 10), ("SessionEnd", None, "end --agent codex", 3)]
    return [(ev, None, "cursor", 10) for ev in CURSOR_EVENTS]


def install_hooks(agent, exe):
    def change(data):
        hooks = data.setdefault("hooks", {})
        if not isinstance(hooks, dict):
            sys.exit(f"devlock install: \"hooks\" in the {agent} config is not an object")
        if agent == "cursor":
            data.setdefault("version", 1)
        for ev in list(hooks):
            hooks[ev] = strip_devlock(hooks[ev], nested=agent != "cursor")
            if not hooks[ev]:
                del hooks[ev]
        for ev, matcher, args, timeout in hook_spec(agent):
            cmd = f"{exe} hook {args}"
            if agent == "cursor":
                entry = {"command": cmd, "timeout": timeout}
            else:
                entry = {"hooks": [{"type": "command", "command": cmd, "timeout": timeout}]}
                if matcher:
                    entry["matcher"] = matcher
            hooks.setdefault(ev, []).append(entry)
        return data

    p = {"claude": os.path.join(claude_dir(), "settings.json"), "codex": os.path.join(codex_dir(), "hooks.json"),
         "cursor": os.path.join(cursor_dir(), "hooks.json")}[agent]
    print(f"{agent}: hooks {update_json(p, change)} in {p}")


def codex_sandbox_root():
    """Let commands Codex runs in its workspace-write sandbox write devlock's state (run, hold,
    release need it): add the state dir to writable_roots in config.toml."""
    p = os.path.join(codex_dir(), "config.toml")
    try:
        with open(p) as f:
            text = f.read()
    except OSError:
        text = ""
    if STATE in text:
        print(f"codex: {STATE} already in {p}")
        return
    if re.search(r"^\s*(\[sandbox_workspace_write\]|sandbox_workspace_write\s*[.=])", text, re.M):
        print(f"codex: add {json.dumps(STATE)} to writable_roots under [sandbox_workspace_write] in {p} "
              "(devlock does not edit an existing table)")
        return
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "a") as f:
        f.write(f"{'' if not text or text.endswith(chr(10)) else chr(10)}\n[sandbox_workspace_write]\n"
                f"# devlock run/hold/release write their state here\nwritable_roots = [{json.dumps(STATE)}]\n")
    print(f"codex: added {STATE} to writable_roots in {p}")


def default_exe():
    """How hooks call devlock: through the Claude skill link when that is this file (the path then
    stays valid on every machine with the same layout), else by absolute path."""
    skill = os.path.join(os.path.expanduser("~/.claude"), "skills", "devlock", "devlock")
    if not os.environ.get("CLAUDE_CONFIG_DIR") and os.path.realpath(skill) == os.path.realpath(SELF):
        return "$HOME/.claude/skills/devlock/devlock"
    return shlex.quote(SELF)


def cmd_install(argv):
    opts, pos = parse_flags("install", argv, {"--claude": False, "--codex": False, "--cursor": False,
                                             "--conf": "", "--exe": ""})
    if pos:
        sys.exit(f"devlock install: unexpected argument {pos[0]}")
    agents = [a for a in AGENTS if opts[f"--{a}"]]
    if not agents:
        agents = [a for a, d in (("claude", claude_dir()), ("codex", codex_dir()), ("cursor", cursor_dir()))
                  if os.path.isdir(d)] or ["claude"]
    os.makedirs(STATE, exist_ok=True)
    if opts["--conf"]:
        src = os.path.realpath(opts["--conf"])
        if not os.path.isfile(src):
            sys.exit(f"devlock install: no such file: {opts['--conf']}")
        if os.path.lexists(CONF) and not os.path.islink(CONF):
            sys.exit(f"devlock install: {CONF} is a file, not a link; move it away first")
        if os.path.lexists(CONF):
            os.remove(CONF)
        os.symlink(src, CONF)
        print(f"devices.conf -> {src}")
    elif not os.path.exists(CONF):
        print(f"warning: no {CONF}: each name is its own device (see --conf, or `devlock doctor --fix`)",
              file=sys.stderr)
    exe = opts["--exe"] or default_exe()
    for agent in agents:
        install_hooks(agent, exe)
    if "codex" in agents:
        codex_sandbox_root()
        print("codex: approve the new hooks once with /hooks in Codex (untrusted hooks do not run)")
    print("Restart running agent sessions to load the hooks.")
    return 0


def agent_hooks_registered(agent):
    """None when the agent is not set up on this machine, else whether devlock's pre hook is in."""
    if agent == "claude":
        ev = hook_events_registered()
        return None if ev is None else "PreToolUse" in ev
    base = codex_dir() if agent == "codex" else cursor_dir()
    if not os.path.isdir(base):
        return None
    data = read_json(os.path.join(base, "hooks.json")) or {}
    pre = (data.get("hooks") or {}).get("PreToolUse" if agent == "codex" else "beforeShellExecution")
    return any(is_devlock_hook(h) for h in hook_entries(pre))


def cmd_doctor(argv):
    opts, pos = parse_flags("doctor", argv, {"--fix": False})
    if pos:
        sys.exit(f"devlock doctor: unexpected argument {pos[0]}")
    bad = 0

    def say(tag, text):
        nonlocal bad
        bad += tag in ("FAIL", "FIX")
        print(f"{tag:5} {text}")

    try:
        os.makedirs(STATE, exist_ok=True)
        with tempfile.NamedTemporaryFile(dir=STATE):
            pass
        say("ok", f"state dir {STATE}")
    except OSError as e:
        say("FAIL", f"state dir {STATE} is not writable: {e}")
    if os.path.islink(CONF) and not os.path.exists(CONF):
        say("FAIL", f"devices.conf is a broken link -> {os.readlink(CONF)}: every name is its own device")
    elif not os.path.exists(CONF):
        say("WARN", f"no {CONF}: each name is its own device (doctor --fix creates it)")
    else:
        real = os.path.realpath(CONF)
        n = sum(1 for l in conf_lines() if device_names(l))
        say("ok", f"devices.conf {CONF}{' -> ' + real if real != CONF else ''} ({n} devices)")
    events = hook_events_registered()
    need = ["PreToolUse", "PostToolUse", "Stop", "SessionEnd"]
    if events is None:
        say("WARN", "no Claude Code settings.json found: hooks not checked")
    elif all(e in events for e in need):
        say("ok", f"Claude Code hooks registered ({', '.join(sorted(events))})")
    else:
        say("FAIL", f"Claude Code hooks missing for {', '.join(e for e in need if e not in events)}: "
            "run `devlock install --claude`")
    for agent, name in (("codex", "Codex"), ("cursor", "Cursor")):
        reg = agent_hooks_registered(agent)
        if reg:
            say("ok", f"{name} hooks registered")
        elif reg is False:
            say("WARN", f"{name} is set up here but devlock's hooks are not: its commands are not checked "
                f"(`devlock install --{agent}`)")

    devs = adb_devices()
    if devs is None:
        say("WARN", f"`{ADB} devices` failed: connected devices not checked")
        return 1 if bad else 0
    sess, probe = session_id(), []
    for name, state in devs:
        if state != "device":
            say("WARN", f"{name}: {state}, cannot read its serial")
        elif blockers([canon(name)], sess):
            say("WARN", f"{name}: in use by another session, not probed (run doctor again when it is free)")
        else:
            probe.append(name)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        serials = list(pool.map(lambda n: (adb("-s", n, "shell", "getprop", "ro.serialno", timeout=10) or "").strip(),
                                probe))
    groups = {}
    for name, serial in zip(probe, serials):
        if serial in GENERIC_SERIALS:
            say("WARN", f"{name}: ro.serialno is {serial or 'empty'!r}, not unique enough to group by")
            continue
        groups.setdefault(serial, set()).add(name)
    problems, fixed = plan_aliases(groups, conf_lines())
    for serial, names in sorted(groups.items()):
        if not any(p.startswith(serial + ":") for p in problems):
            say("ok", f"{serial}: {', '.join(sorted(names))} share one lock")
    for p in problems:
        say("FIX", p)
    if problems and not opts["--fix"]:
        print("\nSuggested devices.conf (device lines that change):")
        old = set(conf_lines())
        for l in fixed:
            if device_names(l) and l not in old:
                print(f"  {l}")
        print("Apply with `devlock doctor --fix`.")
    elif problems:
        try:
            target = write_conf(fixed)
            print(f"\nupdated {target} (backup in {STATE})")
            bad -= len(problems)
        except OSError as e:
            say("FAIL", f"could not write devices.conf: {e}")
    return 1 if bad else 0


def main():
    a = sys.argv[1:]
    if a[:1] == ["hook"]:
        mode = a[1] if len(a) > 1 else "pre"
        agent = "cursor" if mode == "cursor" else (a[a.index("--agent") + 1] if "--agent" in a[:-1] else "claude")
        pre = mode in ("pre", "cursor")
        reason = None
        try:
            try:
                data = json.loads(sys.stdin.read())
            except ValueError:
                data = None
            h = hook_input("pre" if mode == "cursor" else mode, agent, data)
            if h is not None:
                pre = h.mode == "pre"
                load_conf()
                reason = hook(h, agent)
        except Exception as e:  # never block every shell command on a devlock bug
            log(f"ERROR hook {a[1:]}: {e!r}")
        if pre:
            respond(agent, reason)
        return 0
    load_conf()
    if a[:1] == ["run"]:
        return cmd_run(a[1:])
    if a[:1] == ["wait"]:
        return cmd_wait(a[1:])
    if a[:1] == ["status"]:
        return cmd_status(a[1:])
    if a[:1] == ["whoami"]:
        return cmd_whoami()
    if a[:1] == ["check"]:
        return cmd_check(a[1:])
    if a[:1] == ["log"]:
        return cmd_log(a[1:])
    if a[:1] == ["doctor"]:
        return cmd_doctor(a[1:])
    if a[:1] == ["install"]:
        return cmd_install(a[1:])
    if a[:1] == ["hold"]:
        return cmd_hold(a[1:])
    if a[:1] == ["release"]:
        with mutex():
            release(session_id(), a[1] if len(a) > 1 else None)
        return 0
    print(__doc__.strip())
    return 1


if __name__ == "__main__":
    sys.exit(main())
